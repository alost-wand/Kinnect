# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=kinnect_user
DB_PASSWORD=kdbR85
DB_NAME=kinnect_db

# ── Auth ──────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_64_char_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Vault ─────────────────────────────────────────────────────
VAULT_STORAGE_PATH=./vault_storage
VAULT_TOKEN_EXPIRE_MINUTES=10

# ── SMS (Twilio) — leave blank to use stub ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── AI Models (fill in model identifiers) ────────────────────
# Cloud free-tier suggestions:
#   HuggingFace Inference API — free for public models
#   Groq API         — free tier with fast Llama / Mistral
#   Google AI Studio — free Gemini Flash 1.5
#
# Local lightweight (<3B) suggestions:
#   phi-2 (2.7B)    — microsoft/phi-2
#   Qwen1.5-1.8B    — Qwen/Qwen1.5-1.8B
#   TinyLlama-1.1B  — TinyLlama/TinyLlama-1.1B-Chat-v1.0
#   smollm-1.7B     — HuggingFaceTB/SmolLM-1.7B-Instruct
HF_API_TOKEN=                        # HuggingFace token (free)
HF_MODEL_ID=TinyLlama/TinyLlama-1.1B-Chat-v1.0   # swap as needed
GROQ_API_KEY=                        # optional
GROQ_MODEL_ID=llama3-8b-8192         # free on Groq

# YOLOv8 weights (downloaded automatically on first run)
YOLO_MODEL=yolov8n.pt                # nano — lightest
